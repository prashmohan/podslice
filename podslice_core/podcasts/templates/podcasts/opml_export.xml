<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
    <head>
        <title>Podslice Subscriptions</title>
        <dateCreated>{{ created_at }}</dateCreated>
    </head>
    <body>
        {% for podcast in podcasts %}
        <outline text="{{ podcast.title }}" title="{{ podcast.title }}" type="rss" xmlUrl="{{ podcast.rehosted_rss_url }}" />
        {% endfor %}
    </body>
</opml>

# Django secret key
# Generate a new one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your_secret_key_here

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-2.5-pro

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to False when running locally without HTTPS
SECURE_SSL_REDIRECT=False

# Comma-separated list of trusted origins for CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:12343,http://127.0.0.1:12343

# The base URL for rehosted media files
REHOST_BASE_URL=http://localhost:12343

MAX_EPISODES_PER_PODCAST=10

# Poll for new episodes every 12 hours
PODCAST_POLLING_INTERVAL=43200

TIME_ZONE="Australia/Sydney"
